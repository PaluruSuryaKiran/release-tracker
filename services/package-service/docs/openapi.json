{
  "components": {
    "schemas": {
      "PackageCreate": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "default": "",
            "maxLength": 500,
            "title": "Description",
            "type": "string"
          },
          "name": {
            "description": "Lowercase letters, digits and hyphens, starting with a letter.",
            "maxLength": 100,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "PackageCreate",
        "type": "object"
      },
      "PackageOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "latest_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Version"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "created_at"
        ],
        "title": "PackageOut",
        "type": "object"
      },
      "Problem": {
        "description": "An error, in RFC 9457 problem details format.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReleaseCreate": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "description": "MAJOR.MINOR.PATCH, with no leading zeros and no `v` prefix.",
            "maxLength": 15,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "ReleaseCreate",
        "type": "object"
      },
      "ReleaseOut": {
        "properties": {
          "released_at": {
            "format": "date-time",
            "title": "Released At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "released_at"
        ],
        "title": "ReleaseOut",
        "type": "object"
      },
      "ValidationProblem": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "examples": [
              [
                {
                  "field": "name",
                  "message": "String should match pattern '^[a-z][a-z0-9-]*$'"
                }
              ]
            ],
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Errors",
            "type": "array"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "errors"
        ],
        "title": "ValidationProblem",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nRecords software packages and their releases, and reports each package's\nlatest version by semantic version order, so `1.10.0` ranks above `1.9.0`.\n\nEvery error is returned as `application/problem+json`, following\n[RFC 9457](https://www.rfc-editor.org/rfc/rfc9457). Branch on `type`, not on\nthe text of `detail`.\n",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache 2.0"
    },
    "title": "release-tracker",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/livez": {
      "get": {
        "description": "Returns `{\"status\": \"ok\"}` while the process is up.",
        "operationId": "health_check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check that the service is running",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Returns `{\"status\": \"ok\"}` if the database is reachable.",
        "operationId": "readiness_check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check that the service is ready to serve requests",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/packages": {
      "post": {
        "description": "Registers a new package. The `Location` header points to the new package.",
        "operationId": "create_package",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackageCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A package with this name already exists."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "The request body is invalid."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The database is unreachable or too slow. Retry after the number of seconds in the `Retry-After` header."
          }
        },
        "summary": "Create a package",
        "tags": [
          "packages"
        ]
      }
    },
    "/v1/packages/{name}": {
      "get": {
        "description": "Returns the package and its latest version, or `null` if it has no releases.",
        "operationId": "get_package",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "There is no package with this name."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The database is unreachable or too slow. Retry after the number of seconds in the `Retry-After` header."
          }
        },
        "summary": "Get a package",
        "tags": [
          "packages"
        ]
      }
    },
    "/v1/packages/{name}/releases": {
      "post": {
        "description": "Adds a `MAJOR.MINOR.PATCH` release. The `Location` header points to it.",
        "operationId": "create_release",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "There is no package with this name."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The package already has this version."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            },
            "description": "The request body is invalid."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The database is unreachable or too slow. Retry after the number of seconds in the `Retry-After` header."
          }
        },
        "summary": "Add a release",
        "tags": [
          "releases"
        ]
      }
    },
    "/v1/packages/{name}/releases/{version}": {
      "get": {
        "description": "Returns one release of a package.",
        "operationId": "get_release",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "title": "Version",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "There is no such package, or it has no such release."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The database is unreachable or too slow. Retry after the number of seconds in the `Retry-After` header."
          }
        },
        "summary": "Get a release",
        "tags": [
          "releases"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Register packages and look them up.",
      "name": "packages"
    },
    {
      "description": "Add releases to a package and look them up.",
      "name": "releases"
    },
    {
      "description": "Liveness check for load balancers and probes.",
      "name": "health"
    }
  ]
}
