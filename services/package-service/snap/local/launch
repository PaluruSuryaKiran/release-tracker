#!/bin/sh
set -e

for file in "$DATABASE_URL_FILE" "$API_KEY_FILE"; do
    if [ ! -s "$file" ]; then
        echo "Missing secret file $file. See the README's Quick start to create it." >&2
        exit 1
    fi
done

PORT="$(snapctl get port)"
PORT="${PORT:-8000}"

exec "$SNAP/bin/uvicorn" package_service.main:app --host 0.0.0.0 --port "$PORT" --timeout-graceful-shutdown 20